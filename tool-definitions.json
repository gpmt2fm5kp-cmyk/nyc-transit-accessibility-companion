                  },
                  "locationDescription": {
                    "type": "string"
                  },
                  "stepFree": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no",
                      "unknown"
                    ]
                  },
                  "entryAllowed": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "exitAllowed": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "services": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "directionNotes": {
                    "type": "string"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string"
                        },
                        "title": {
