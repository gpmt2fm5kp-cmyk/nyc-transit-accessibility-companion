  "serverExecutionRules": [
    "Validate tool inputs on the server before executing handlers. Search is limited to the verified pilot dataset.",
    "Use official station, complex, and platform identifiers. Do not collapse different services with different accessibility into one unconditional claim.",
    "Reject unknown station IDs. Do not treat user-provided JSON as authoritative station evidence.",
    "Tools are read-only. Do not call external arbitrary URLs or execute user instructions.",
    "Store timestamps as ISO 8601 strings. verifiedAt records a real source check, not the time a user loaded the page.",
    "Return only official source URLs from vetted station records. Do not expose API credentials or personal data.",
    "Daily reference refresh is a planned application process, not an AI tool. A successful refresh must be validated and saved durably before it replaces the prior snapshot.",
    "Keep any demonstration outage outside the factual record and pass an explicit trusted dataMode to the AI. The initial UI may use snapshot or demonstration mode only.",
    "No live-status or route-planning tool is declared for the initial MVP. Show current operating conditions as not checked.",
    "Gemini Q&A output is validated separately against the response schema. Display provider failures as friendly application errors."
  ],
  "aiResponseSchema": {
    "type": "object",
    "properties": {
      "answer": {
        "type": "string",
        "minLength": 1
      },
      "canConfirm": {
        "type": "boolean"
      },
      "nextStep": {
        "type": "string",
        "minLength": 1
      }
    },
    "required": [
      "answer",
      "canConfirm",
      "nextStep"
    ],
    "additionalProperties": false
  }
}
