            "directionNotes",
            "entrances",
            "platformNotes",
            "equipmentNotes",
            "currentElevatorStatus",
            "officialStatusUrl",
            "snapshotVerifiedAt",
            "lastSuccessfulRefreshAt",
            "refreshState",
            "sources",
            "aliases",
            "platforms"
          ],
          "additionalProperties": false
        }
      },
      "required": [
