                },
                "stationName": {
                  "type": "string"
                },
                "borough": {
                  "type": "string"
                },
                "services": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "stationId",
                "stationName",
                "borough",
                "services"
              ],
              "additionalProperties": false
            },
            "adaClassification": {
