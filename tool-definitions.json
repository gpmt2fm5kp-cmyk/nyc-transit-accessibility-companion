{
  "project": "Access Granted NYC Transit Accessibility Companion",
  "version": "2026-11-12",
  "implementationStatus": "Read-only station tools and Gemini Q&A implemented. Public deployment and real Gemini calls previously verified. Pilot now contains 15 station complexes across all five boroughs. A separate HTTP equipment endpoint supplies MTA elevator/escalator locations and reports; the AI does not receive these reports. Station-reference auto-refresh remains unimplemented.",
  "functionDeclarations": [
    {
      "name": "search_stations",
      "description": "Search only verified station records loaded in the pilot. Return distinct station or platform identifiers, station names, boroughs, and services. Ambiguous names can return multiple matches; no result does not establish that a station does not exist.",
      "parametersJsonSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120,
            "default": ""
          },
          "borough": {
            "type": "string",
            "enum": [
              "All",
              "Manhattan",
              "Bronx",
              "Brooklyn",
              "Queens",
              "Staten Island"
            ],
            "default": "All"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "get_station_accessibility",
      "description": "Retrieve the selected verified station reference including entrance/platform restrictions, official sources and dates. This tool does not check current equipment conditions; use the separate equipment panel.",
      "parametersJsonSchema": {
        "type": "object",
        "properties": {
          "stationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "stationId"
        ],
        "additionalProperties": false
      }
    }
  ],
  "outputContracts": {
    "search_stations": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stationId": {
                "type": "string"
              },
              "stationName": {
                "type": "string"
              },
              "borough": {
                "type": "string"
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "classification": {
                "type": "string",
                "enum": [
                  "fully_accessible",
                  "partially_accessible",
                  "not_accessible",
                  "unknown"
                ]
              }
            },
            "required": [
              "stationId",
              "stationName",
              "borough",
              "services",
              "classification"
            ],
            "additionalProperties": false
          }
        },
        "coverageNote": {
          "type": "string"
        }
      },
      "required": [
        "matches",
        "coverageNote"
      ],
      "additionalProperties": false
    },
    "get_station_accessibility": {
      "type": "object",
      "properties": {
        "record": {
