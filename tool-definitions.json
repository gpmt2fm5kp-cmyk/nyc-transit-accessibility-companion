{
  "project": "Access Granted NYC Transit Accessibility Companion",
  "version": "2026-11-11",
  "implementationStatus": "Read-only server handlers and frontend integration implemented and tested. The server invokes tools deterministically. Live Gemini calls and deployment await private GEMINI_API_KEY configuration and verification. Automatic refresh and live elevator status are not implemented.",
  "functionDeclarations": [
    {
      "name": "search_stations",
      "description": "Search only verified station records loaded in the pilot. Return distinct station or platform identifiers, station names, boroughs, and services. Ambiguous names can return multiple matches; no result does not establish that a station does not exist.",
      "parametersJsonSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 0,
            "maxLength": 120,
            "default": ""
          },
          "borough": {
            "type": "string",
            "enum": [
              "All",
              "Manhattan",
              "Bronx",
              "Brooklyn",
              "Queens"
            ],
            "default": "All"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "get_station_accessibility",
      "description": "Retrieve one verified station record using an ID returned by station search. Include direction and entrance restrictions, official sources, and snapshot dates. The initial version does not check live elevator conditions.",
      "parametersJsonSchema": {
        "type": "object",
        "properties": {
          "stationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "stationId"
        ],
        "additionalProperties": false
      }
    }
  ],
  "outputContracts": {
    "search_stations": {
      "type": "object",
      "properties": {
        "matches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stationId": {
                "type": "string"
              },
              "stationName": {
                "type": "string"
              },
              "borough": {
                "type": "string"
              },
              "services": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "classification": {
                "type": "string",
                "enum": [
                  "fully_accessible",
                  "partially_accessible",
                  "not_accessible",
                  "unknown"
                ]
              }
            },
            "required": [
              "stationId",
              "stationName",
              "borough",
              "services",
              "classification"
            ],
            "additionalProperties": false
          }
        },
        "coverageNote": {
          "type": "string"
        }
      },
      "required": [
        "matches",
        "coverageNote"
      ],
      "additionalProperties": false
    },
